# Copy to .env and fill in real values. NEVER commit the real .env.
# Generate strong secrets, e.g.:
#   INFLUX_TOKEN: openssl rand -hex 24
#   JWT_SECRET:   openssl rand -hex 32

# --- InfluxDB ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE_ME_strong_password
INFLUX_ORG=romii_org
INFLUX_BUCKET=romii_bucket
INFLUX_RETENTION=30d
INFLUX_TOKEN=CHANGE_ME_influx_admin_token

# --- Backend auth ---
JWT_SECRET=CHANGE_ME_long_random_secret_min_16_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_initial_admin_password   # seeds the first admin on first boot

# --- Misc ---
DATA_SOURCE=plc          # 'mock' when running the demo profile, 'plc' for a real PLC
MAX_WELL_DEPTH_M=100000  # sanity clamp for PLC-supplied bit/hole depth in metres
FRONTEND_BIND=0.0.0.0    # listen on all host interfaces; use the PC's current LAN IP
                         # from another machine, e.g. http://<pc-ip>:8080.
FRONTEND_PORT=8080       # dashboard published on ${FRONTEND_BIND}:<port>
MOCK_INTERVAL_MS=1000
# comma-separated extra browser origins; empty = same-origin only
CORS_ORIGIN=

# --- Windows domain / Active Directory login (optional) ---
# AUTH_MODE: local (default) | ldap | both. 'both' = local break-glass + domain users.
AUTH_MODE=local
# ldaps://dc01.corp.example.com:636  (use ldaps:// in production)
LDAP_URL=
# service account, e.g. CN=svc-romii,OU=Service,DC=corp,DC=example,DC=com
LDAP_BIND_DN=
# service-account password (leave blank to use direct UPN bind)
LDAP_BIND_PASSWORD=
# DC=corp,DC=example,DC=com
LDAP_SEARCH_BASE=
# default (|(sAMAccountName={username})(userPrincipalName={username}))
LDAP_SEARCH_FILTER=
# corp.example.com  (used to build user@domain UPN)
LDAP_DOMAIN=
LDAP_DEFAULT_ROLE=viewer        # role for authenticated users in no mapped group
# AD group(s) -> admin   (comma-separated CNs, e.g. RigAdmins)
LDAP_ROLE_ADMIN=
# AD group(s) -> operator (e.g. Drillers,ToolPushers)
LDAP_ROLE_OPERATOR=
# AD group(s) -> viewer
LDAP_ROLE_VIEWER=
# true to upgrade ldap:// with StartTLS
LDAP_STARTTLS=
LDAP_TLS_REJECT_UNAUTHORIZED=true   # set false ONLY for self-signed lab DCs

# --- Central facility sync (optional; disabled for edge-only Docker) ----------
# Leave disabled when this rig is running as a standalone local edge stack.
# If a separate central server is deployed elsewhere, enable sync and point
# CENTRAL_URL at that external /ingest base URL. Data flow is outbound only.
SYNC_ENABLED=false
# e.g. https://crmf.ongc.local
CENTRAL_URL=
DEVICE_ID=AHWR-50-03                           # UNIQUE per rig
# required only when sync is enabled
DEVICE_TOKEN=
SYNC_BATCH_SECONDS=10                       # batch seal cadence (lower = fresher, more WAN overhead)
SYNC_BUFFER_DAYS=15                         # store-and-forward disk buffer cap during WAN outage

# --- ETP 2.0 publisher (outbound only; optional) ------------------------------
ETP_ENABLED=false
# ws(s):// ETP server; blank disables
ETP_URL=
